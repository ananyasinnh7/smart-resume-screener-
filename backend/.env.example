# =====================================================================
# STEP 1: Copy this file to a new file named ".env" in this same folder:
#     cp .env.example .env
#
# STEP 2: Get a free key from https://console.groq.com -> API Keys
#
# STEP 3: Paste it below, replacing the placeholder text.
# =====================================================================
GROQ_API_KEY=gsk_your-key-here

# Which model to use. openai/gpt-oss-120b is Groq's current flagship
# (as of mid-2026). Change this if Groq retires/renames it again.
DEFAULT_MODEL=openai/gpt-oss-120b
